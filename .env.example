# DO2603 starter 0.2.3. Copy to .env. Never commit actual keys.
# No paid services or model downloads in the default profile.
RAG_MODE=fixture
LLM_PROVIDER=fixture
EMBEDDING_PROVIDER=fixture
API_PORT=8000
WEB_PORT=3000
PROMETHEUS_PORT=9090
LLM_MAX_TOKENS=1024
EMBEDDING_DIM=1024
EMBEDDING_REVISION=1
PROVIDER_TIMEOUT_SECONDS=60
# REAL mode: set RAG_MODE=real and both providers explicitly.
# LLM: gemini | anthropic | openai | ollama
# Embedding: gemini | voyage | openai | ollama
# Never reuse a populated fixture index for real embeddings. See GETTING_STARTED.
LLM_MODEL=
EMBEDDING_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
OPENAI_API_KEY=
# Explicit endpoint required, e.g. https://api.openai.com/v1 or a vetted gateway.
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional LiteLLM profile: docker compose --profile litellm up -d.
# Do not commit the populated local .env file or virtual-key values.
LITELLM_PORT=4000
LITELLM_MASTER_KEY=
LITELLM_API_KEY=
INSIGHTHUB_APP_LITELLM_KEY=
CHATOPS_BOT_LITELLM_KEY=
CODING_WORKFLOW_LITELLM_KEY=
LITELLM_UPSTREAM_CHAT_MODEL=openai/gpt-4o-mini
LITELLM_FALLBACK_CHAT_MODEL=openai/gpt-4o-mini
LITELLM_UPSTREAM_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional FinOps estimate: JSON map of LiteLLM model name to the provider's
# actual prompt input vs. cache-read price difference (USD per million tokens).
# Leave empty until verified against current provider pricing; no savings metric
# is emitted for an unconfigured model.
LITELLM_PROMPT_CACHE_SAVINGS_USD_PER_MILLION_BY_MODEL=
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
# Chat model chosen after measuring available RAM/latency and quality.
# mxbai-embed-large emits 1024 dimensions; no padding/truncation.
