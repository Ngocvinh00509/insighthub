{
  "__inputs": [{ "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }],
  "annotations": { "list": [{ "name": "Deploy events", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "enable": true, "iconColor": "#5794F2", "target": { "expr": "changes(kube_deployment_status_observed_generation{namespace=\"$namespace\",deployment=~\".*insighthub.*\"}[5m]) > 0", "refId": "Deployments" }, "titleFormat": "InsightHub deployment", "textFormat": "Deployment generation changed in $namespace", "tags": ["deploy", "insighthub"] }] },
  "description": "InsightHub Day 4: exactly nine RED/USE and generation-observability panels. A missing queue or cost series is unavailable, not zero.",
  "editable": true,
  "panels": [
    { "id": 1, "title": "RED Rate - request rate by route", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }, "targets": [{ "expr": "sum by (endpoint) (rate(insighthub_http_requests_total{namespace=\"$namespace\"}[5m]))", "legendFormat": "{{endpoint}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } } },
    { "id": 2, "title": "RED Errors - HTTP 5xx rate", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }, "targets": [{ "expr": "sum(rate(insighthub_http_requests_total{namespace=\"$namespace\",status=~\"5..\"}[5m]))", "legendFormat": "5xx errors", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } } },
    { "id": 3, "title": "RED Duration - RAG p95", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }, "targets": [{ "expr": "insighthub:rag_query_latency_p95{namespace=\"$namespace\"}", "legendFormat": "RAG p95", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } } },
    { "id": 4, "title": "Queue depth - outstanding ARQ sorted-set entries", "description": "No series means worker/Redis telemetry is unavailable; it must not be read as queue depth zero.", "type": "stat", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 }, "targets": [{ "expr": "sum(insighthub_queue_depth{namespace=\"$namespace\"})", "legendFormat": "pending jobs", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" } },
    { "id": 5, "title": "Generation token usage - provider reported", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 }, "targets": [{ "expr": "sum by (provider, direction) (rate(insighthub_llm_tokens_total{namespace=\"$namespace\"}[5m])) * 60", "legendFormat": "{{provider}} {{direction}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } } },
    { "id": 6, "title": "Generation latency p95", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 }, "targets": [{ "expr": "insighthub:llm_latency_p95{namespace=\"$namespace\"}", "legendFormat": "LLM p95", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } } },
    { "id": 7, "title": "Estimated generation cost - approved model only", "description": "Estimate for complete provider usage from gpt-5.6-sol only; excludes embedding and infrastructure and is not a bill. No series is unavailable, not USD 0.", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 }, "targets": [{ "expr": "sum(rate(insighthub_llm_generation_estimated_cost_dollars_total{namespace=\"$namespace\"}[5m])) * 3600", "legendFormat": "USD/hour", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } } },
    { "id": 8, "title": "USE Resources - InsightHub pod CPU and RAM", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 }, "targets": [{ "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"insighthub-.*\",container!=\"\"}[5m]))", "legendFormat": "CPU {{pod}}", "refId": "A" }, { "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",pod=~\"insighthub-.*\",container!=\"\"})", "legendFormat": "RAM {{pod}}", "refId": "B" }], "fieldConfig": { "defaults": {}, "overrides": [{ "matcher": { "id": "byRegexp", "options": "^CPU.*" }, "properties": [{ "id": "unit", "value": "cores" }] }, { "matcher": { "id": "byRegexp", "options": "^RAM.*" }, "properties": [{ "id": "unit", "value": "bytes" }] }] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } } },
    { "id": 9, "title": "Deployment history", "description": "kube-state-metrics deployment generation; actual rollout annotations are configured at dashboard level.", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "gridPos": { "h": 9, "w": 12, "x": 12, "y": 16 }, "targets": [{ "expr": "kube_deployment_status_observed_generation{namespace=\"$namespace\",deployment=~\".*insighthub.*\"}", "legendFormat": "{{deployment}} generation", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } } }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["insighthub", "red", "use", "generation"],
  "templating": { "list": [{ "name": "namespace", "label": "Namespace", "type": "query", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "definition": "label_values(kube_pod_info, namespace)", "query": { "query": "label_values(kube_pod_info, namespace)", "refId": "NamespaceVariableQuery" }, "includeAll": false, "multi": false, "hide": 0, "refresh": 1, "current": { "selected": true, "text": "insighthub-dev", "value": "insighthub-dev" }, "options": [] }] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "InsightHub - Day 4 RED, USE and Generation",
  "uid": "insighthub-overview",
  "version": 1
}
